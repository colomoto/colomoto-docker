#!/bin/bash
set -e
set -u

: "${UID:=1000}"
: "${GID:=${UID}}"

echo "UID: $UID"
echo "GID: $GID"

if [ "$#" = 0 ]
then set -- "$(command -v bash 2>/dev/null || command -v sh)" -l
fi

set -x

if [ "$UID" != 0 ]; then
    [ "$UID" -ne 1000 ] && usermod -u "$UID" user
    [ "$GID" -ne 1000 ] && groupmod -g "$GID" user
    [ "$UID" -ne 1000 ] && chown -R user: /home/user
fi

gosu user "${@}"
